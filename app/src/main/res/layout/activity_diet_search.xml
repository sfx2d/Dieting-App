<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        xmlns:app="http://schemas.android.com/apk/res-auto">
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:rowCount="4"
            android:columnCount="2"
            android:paddingStart="20sp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:clickable="true"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/black"
                app:strokeWidth="1dp"
                android:id="@+id/appleSauceFrenchToastMCV">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <ImageView
                        android:layout_width="120sp"
                        android:layout_height="120sp"
                        android:layout_gravity="center"
                        android:src="@drawable/image_applesaucefrenchtoast"/>


                    <TextView
                        android:layout_width="120sp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Applesauce French Toast"
                        android:textAppearance="?attr/textAppearanceHeadline6" />




                    <TextView
                        android:layout_width="120sp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="This is a description inside the material card." />




                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView


                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/black"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <ImageView
                        android:layout_width="120sp"
                        android:layout_height="120sp"
                        android:layout_gravity="center"
                        android:src="@drawable/image_anyberrysauce"/>


                    <TextView
                        android:layout_width="120sp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Any Berry Sauce"
                        android:textAppearance="?attr/textAppearanceHeadline6" />




                    <TextView
                        android:layout_width="120sp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="This is a description inside the material card." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView


                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/black"
                app:strokeWidth="1dp">




                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <ImageView
                        android:layout_width="120sp"
                        android:layout_height="120sp"
                        android:layout_gravity="center"
                        android:src="@drawable/image_breakfastburritos"/>


                    <TextView
                        android:layout_width="120sp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Breakfast Burritos"
                        android:textAppearance="?attr/textAppearanceHeadline6" />




                    <TextView
                        android:layout_width="120sp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="This is a description inside the material card." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView


                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/black"
                app:strokeWidth="1dp">




                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <ImageView
                        android:layout_width="120sp"
                        android:layout_height="120sp"
                        android:layout_gravity="center"
                        android:src="@drawable/image_ovenbakedsalmon"/>


                    <TextView
                        android:layout_width="120sp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Oven Baked Salmon"
                        android:textAppearance="?attr/textAppearanceHeadline6" />




                    <TextView
                        android:layout_width="120sp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="This is a description inside the material card." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView


                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/black"
                app:strokeWidth="1dp">




                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <ImageView
                        android:layout_width="120sp"
                        android:layout_height="120sp"
                        android:layout_gravity="center"
                        android:src="@drawable/image_bakedmeatballs"/>


                    <TextView
                        android:layout_width="120sp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Baked Meatballs"
                        android:textAppearance="?attr/textAppearanceHeadline6" />




                    <TextView
                        android:layout_width="120sp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="This is a description inside the material card." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView


                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/black"
                app:strokeWidth="1dp">




                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <ImageView
                        android:layout_width="120sp"
                        android:layout_height="120sp"
                        android:layout_gravity="center"
                        android:src="@drawable/image_cheesybeefpasta"/>


                    <TextView
                        android:layout_width="120sp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Cheesy Beef Pasta"
                        android:textAppearance="?attr/textAppearanceHeadline6" />




                    <TextView
                        android:layout_width="120sp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="This is a description inside the material card." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView


                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/black"
                app:strokeWidth="1dp">




                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <ImageView
                        android:layout_width="120sp"
                        android:layout_height="120sp"
                        android:layout_gravity="center"
                        android:src="@drawable/image_fiestabarleysalad"/>


                    <TextView
                        android:layout_width="120sp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Fiesta Barely Salad"
                        android:textAppearance="?attr/textAppearanceHeadline6" />




                    <TextView
                        android:layout_width="120sp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="This is a description inside the material card." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView


                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/black"
                app:strokeWidth="1dp">




                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <ImageView
                        android:layout_width="120sp"
                        android:layout_height="120sp"
                        android:layout_gravity="center"
                        android:src="@drawable/image_lentiltacofilling"/>


                    <TextView
                        android:layout_width="120sp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Lentil Taco Filling"
                        android:textAppearance="?attr/textAppearanceHeadline6" />




                    <TextView
                        android:layout_width="120sp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="This is a description inside the material card." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


        </GridLayout>
    </LinearLayout>
</ScrollView>
